# ─────────────────────────────────────────────────────────────
# Tracing Weavers — environment
# Copy to .env.local, fill in, never commit.
# There is no wallet and no chain: none of these are blockchain keys.
# ─────────────────────────────────────────────────────────────

# Public origin written onto the NFC tags / QR codes.
# A tag always carries `${NEXT_PUBLIC_SITE_URL}/t/<TAG_CODE>`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand in the shell (the default is fine to start).
NEXT_PUBLIC_BRAND=Tracing Weavers

# Signs passport ids and the session cookie. Any long random string:
#   openssl rand -hex 32
PASSPORT_SIGNING_SECRET=

# ── where issued passports are stored ────────────────────────────────────
# file = data/passports.json, fine for local dev — NOT for Vercel, whose
#        filesystem is read-only.
# kv   = Redis over REST. This is the one that needs no extra code: install
#        **Upstash** from Vercel → Storage → Marketplace and connect it. The
#        integration injects the url + token; either naming works:
#          KV_REST_API_URL / KV_REST_API_TOKEN
#          UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Neon / Supabase / Prisma / Turso (Postgres or SQLite) need the adapter in
# lib/store.ts swapped — the schema is in the comment at the top of that file.
PASSPORT_STORE=file
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── the programme team's own view, and the traffic numbers ────────────────────
# Half of /api/passports and the whole of /insights are behind this. Any long
# random string:  openssl rand -hex 32
PASSPORT_ADMIN_TOKEN=

# /insights reads the visits Vercel already collects, through the public Web
# Analytics API. Turn on Web Analytics for the project first
# (Vercel → Project → Analytics), then:
#   1. create an access token at vercel.com/account/tokens
#   2. copy the project id from Project → Settings → General
#   3. add both below (plus VERCEL_TEAM_ID or VERCEL_TEAM_SLUG for a team project)
#   4. redeploy, then open /api/admin?key=<PASSPORT_ADMIN_TOKEN> once
# Numbers are production-only, and the range you can ask for depends on the
# plan's reporting window.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=